# CivicPulse AI Environment Configuration

APP_NAME="CivicPulse AI"
APP_ENV=development
DEBUG=true

# Ollama local inference settings
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=qwen2.5vl:3b
TEXT_MODEL=qwen2.5:1.5b
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

# Database (Default: SQLite local database; change to Supabase/PostgreSQL URL if desired)
DATABASE_URL=sqlite:///./civicpulse.db

# Storage
MAX_UPLOAD_SIZE_BYTES=10485760

# Authorized reviewer secret token for /api/reports/{id}/updates
REVIEWER_SECRET_KEY=civicpulse-reviewer-dev-key-secure
